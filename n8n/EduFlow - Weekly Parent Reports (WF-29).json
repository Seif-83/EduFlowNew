    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googlePalmApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contents: [{ role: 'user', parts: [{ text: $json.prompt }] }], generationConfig: { temperature: 0.4, responseMimeType: 'application/json' } }) }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          },
          "timeout": 60000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "name": "AI | Write Report (Gemini)",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "id": "850f5e6d-6305-47e6-a50f-51d119c37d89",
      "position": [
        1120,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const prompts = $('CODE | Build Report Prompts').all().map(x => x.json);\nconst aiItems = $input.all().map(x => x.json);\nconst out = [];\n\naiItems.forEach((r, i) => {\n  const b = prompts[i];\n  if (!b || r.statusCode !== 200 || !r.body) return;\n\n  let text =\n    r.body.candidates &&\n    r.body.candidates[0] &&\n    r.body.candidates[0].content &&\n    r.body.candidates[0].content.parts &&\n    r.body.candidates[0].content.parts[0] &&\n    r.body.candidates[0].content.parts[0].text;\n\n  if (!text || typeof text !== 'string') return;\n\n  text = text.replace(/^```(?:json)?/i, '').replace(/```$/, '').trim();\n  let report = '';\n  try {\n    const parsed = JSON.parse(text);\n    report = (parsed && parsed.report) ? String(parsed.report) : '';\n  } catch (e) {\n    report = text;\n  }\n\n  report = report.trim().slice(0, 1900);\n  if (!report) return;\n\n  out.push({\n    json: {\n      user_ids: [b.parent_id],\n      notification_type: 'weekly_report',\n      title: `التقرير الأسبوعي: ${b.student_name}`,\n      message: report,\n      related_url: `/children/${b.student_id}/weekly-report`,\n      dedupe_key: `weekly:${b.student_id}:${b.week}`\n    }\n  });\n});\n\nreturn out;"
      },
