    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nif (r.statusCode !== 200 || !Array.isArray(r.body)) {\n  return [];\n}\n\nconst since = new Date(Date.now() - 7 * 86400000).toISOString();\nconst week = new Date().toISOString().slice(0, 10);\n\nreturn r.body\n  .filter(l => l && l.parent_id && l.student_id)\n  .map(l => ({\n    json: {\n      parent_id: String(l.parent_id).trim(),\n      student_id: String(l.student_id).trim(),\n      since,\n      week\n    }\n  }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "name": "CODE | List Children",
      "id": "18e3d956-af44-465a-9c38-fcc05bb92481",
      "position": [
        448,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://zhbntxnsdznpdqmjyxpp.supabase.co/rest/v1/rpc/student_summary_core",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_student_id: $json.student_id, p_since: $json.since }) }}",
        "options": {
