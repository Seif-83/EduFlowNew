      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "name": "DB | Weekly Student Summary",
      "id": "4a9b766a-0c2f-4746-b5b1-ba0decd94ef2",
      "position": [
        672,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const children = $('CODE | List Children').all().map(x => x.json);\nconst responses = $input.all().map(x => x.json);\nconst out = [];\n\nresponses.forEach((r, i) => {\n  const child = children[i];\n  if (!child || r.statusCode !== 200 || !r.body) return;\n\n  // Handle RPC returning either an object or a 1-element array\n  const s = Array.isArray(r.body) ? r.body[0] : r.body;\n  if (!s || typeof s !== 'object') return;\n\n  const hasAttendance = Array.isArray(s.attendance) && s.attendance.length > 0;\n  const hasExams = Array.isArray(s.exams) && s.exams.length > 0;\n  const hasHomework = Array.isArray(s.homework) && s.homework.length > 0;\n  if (!hasAttendance && !hasExams && !hasHomework) return;\n\n  const name = (s.student && s.student.full_name) ? String(s.student.full_name).trim() : 'ابنك';\n  const prompt =\n    'اكتب تقرير أسبوعي قصير (حد أقصى 120 كلمة) بالعربي المصري المبسط لولي أمر عن ابنه/ابنته ' +\n    name +\n    '، اعتمادًا فقط على البيانات التالية، من غير ما تخترع أي معلومة. اذكر الحضور والامتحانات والواجبات، ونقطة قوة واحدة ونقطة تحتاج تحسين. ' +\n    'ارجع JSON بالشكل {\"report\":\"النص\"} فقط.\\nالبيانات: ' +\n    JSON.stringify({\n      attendance: s.attendance || [],\n      exams: s.exams || [],\n      homework: s.homework || []\n    });\n\n  out.push({\n    json: {\n      parent_id: child.parent_id,\n      student_id: child.student_id,\n      week: child.week,\n      student_name: name,\n      prompt\n    }\n  });\n});\n\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "name": "CODE | Build Report Prompts",
      "id": "effece23-245c-4ddc-a49a-7707e7ec38bd",
      "position": [
