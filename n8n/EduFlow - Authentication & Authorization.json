    {
      "parameters": {
        "jsCode": "const base = $('CODE | Validate Input').first().json;\nconst auth = $('AUTH | Verify Access Token').first().json.body;\nconst prof = $('DB | Fetch Own Profile').first().json;\nconst wm = $('DB | Fetch Own Memberships').first().json;\nconst par = $('DB | Fetch Own Parent Links').first().json;\nconst bad = (code, message, extra) => [{ json: { need_group: false, final: { success: false, authenticated: true, authorized: false, code, message, ...(extra || {}) } } }];\nif (prof.statusCode !== 200 || !Array.isArray(prof.body) || prof.body.length === 0) return bad('FORBIDDEN', 'User profile not found');\nconst profile = prof.body[0];\nconst members = (wm.statusCode === 200 && Array.isArray(wm.body)) ? wm.body : [];\nconst links = (par.statusCode === 200 && Array.isArray(par.body)) ? par.body : [];\nconst roles = new Set();\nif (profile.role) roles.add(profile.role);\nfor (const m of members) {\n  if (m.member_role === 'owner' || m.member_role === 'teacher') roles.add('teacher');\n  if (m.member_role === 'assistant') roles.add('assistant');\n}\nif (links.length > 0) roles.add('parent');\nconst perms = {};\nfor (const m of members.filter(x => x.member_role === 'assistant')) {\n  for (const [k, v] of Object.entries(m.permissions || {})) if (v === true || v === 'true') perms[k] = true;\n}\nconst rolesArr = [...roles];\nconst user = {\n  user_id: auth.id, email: auth.email, full_name: profile.full_name || null, profile_role: profile.role || null,\n  roles: rolesArr, is_admin: roles.has('admin'),\n  memberships: members.map(m => ({ workspace_id: m.workspace_id, member_role: m.member_role, permissions: m.permissions || {} })),\n  assistant_permissions: Object.keys(perms), children_ids: links.map(l => l.student_id)\n};\nconst req = base.required_roles || [];\nif (req.length && !req.some(r => roles.has(r))) return bad('FORBIDDEN', 'User does not have the required role', { roles: rolesArr });\nif (base.group_id) {\n  const calls = [{ rpc: 'is_group_teacher', body: { p_group_id: base.group_id } }, { rpc: 'is_group_student', body: { p_group_id: base.group_id } }];\n  const r = base.group_requirement;\n  if (r && r.startsWith('manage:')) calls.push({ rpc: 'has_group_assistant_permission', body: { p_group_id: base.group_id, p_permission: r.slice(7) } });\n  return [{ json: { need_group: true, user, calls } }];\n}\nreturn [{ json: { need_group: false, final: { success: true, authenticated: true, authorized: true, code: 'OK', role: profile.role || null, ...user } } }];"
      },
