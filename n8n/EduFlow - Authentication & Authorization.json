    {
      "parameters": {
        "jsCode": "const ctx = $('CODE | Evaluate Roles').first().json;\nconst user = ctx.user;\nconst base = $('CODE | Validate Input').first().json;\nconst res = $input.all().map(i => i.json);\nif (res.some(x => x.statusCode !== 200)) return [{ json: { success: false, authenticated: true, authorized: false, code: 'UPSTREAM_ERROR', message: 'Group permission check failed' } }];\nconst val = k => res[k] && res[k].body === true;\nconst r = base.group_requirement;\nconst ga = { is_teacher: val(0), is_student: val(1), has_permission: (r && r.startsWith('manage:')) ? val(2) : false };\nlet ok = true;\nif (r === 'teacher') ok = user.is_admin || ga.is_teacher;\nelse if (r === 'student') ok = ga.is_student;\nelse if (r === 'teacher_or_student') ok = user.is_admin || ga.is_teacher || ga.is_student;\nelse if (r && r.startsWith('manage:')) ok = user.is_admin || ga.is_teacher || ga.has_permission;\nreturn [{ json: { success: ok, authenticated: true, authorized: ok, code: ok ? 'OK' : 'FORBIDDEN', message: ok ? undefined : 'No access to this group', role: user.profile_role, ...user, group_id: base.group_id, group_access: ga } }];"
      },
