        "jsCode": "const raw = $input.first().json;\nconst i = (raw.body && typeof raw.body === 'object') ? { ...raw, ...raw.body } : raw;\n\nconst token = typeof i.access_token === 'string' ? i.access_token.replace(/^Bearer\\s+/i, '').trim() : '';\nconst okToken = /^[A-Za-z0-9\\-_]+\\.[A-Za-z0-9\\-_]+\\.[A-Za-z0-9\\-_]+$/.test(token);\nconst uuidRe = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\nconst groupId = i.group_id ? String(i.group_id).trim() : '';\n\nif (!okToken) return [{ json: { valid: false, code: 'UNAUTHENTICATED', message: 'Missing or malformed access token' } }];\nif (groupId && !uuidRe.test(groupId)) return [{ json: { valid: false, code: 'VALIDATION', message: 'group_id is not a valid UUID' } }];\n\nlet roles = [];\nif (Array.isArray(i.required_roles)) roles = i.required_roles;\nelse if (typeof i.required_roles === 'string' && i.required_roles) roles = i.required_roles.split(',').map(s => s.trim());\n\nreturn [{ json: { valid: true, access_token: token, required_roles: roles, group_id: groupId || null, group_requirement: i.group_requirement || null } }];"
      },
