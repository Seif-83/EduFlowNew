    {
      "parameters": {
        "jsCode": "\nconst i = $input.first().json;\n\nconst uuidRe =\n  /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\n\nconst fail = (message) => [{\n  json: {\n    valid: false,\n    code: 'VALIDATION',\n    message,\n  },\n}];\n\nconst title = typeof i.title === 'string'\n  ? i.title.trim()\n  : '';\n\nconst message = typeof i.message === 'string'\n  ? i.message.trim()\n  : '';\n\nif (!title || title.length > 200) {\n  return fail('Title is required and must not exceed 200 characters.');\n}\n\nif (!message || message.length > 2000) {\n  return fail('Message is required and must not exceed 2000 characters.');\n}\n\nif (\n  i.user_ids !== undefined &&\n  !Array.isArray(i.user_ids)\n) {\n  return fail('user_ids must be an array.');\n}\n\nconst userIds = Array.isArray(i.user_ids)\n  ? [...new Set(i.user_ids.map(String))]\n  : [];\n\nif (!userIds.every(id => uuidRe.test(id))) {\n  return fail('Every user_id must be a valid UUID.');\n}\n\nconst groupId = i.group_id\n  ? String(i.group_id).trim()\n  : null;\n\nif (groupId && !uuidRe.test(groupId)) {\n  return fail('group_id must be a valid UUID.');\n}\n\nif (!userIds.length && !groupId) {\n  return fail('Provide at least one user_id or a group_id.');\n}\n\nif (\n  i.include_parents !== undefined &&\n  typeof i.include_parents !== 'boolean'\n) {\n  return fail('include_parents must be a boolean.');\n}\n\nconst type = typeof i.notification_type === 'string'\n  ? i.notification_type.trim()\n  : 'general';\n\nif (!type || type.length > 50) {\n  return fail('notification_type must be between 1 and 50 characters.');\n}\n\nlet relatedUrl = null;\n\nif (i.related_url) {\n  if (typeof i.related_url !== 'string') {\n    return fail('related_url must be a string.');\n  }\n\n  relatedUrl = i.related_url.trim();\n\n  if (relatedUrl.length > 2048) {\n    return fail('related_url is too long.');\n  }\n}\n\nconst dedupeKey = i.dedupe_key\n  ? String(i.dedupe_key).trim()\n  : `${type}:${relatedUrl || title}:${new Date().toISOString().slice(0, 10)}`;\n\nif (!dedupeKey || dedupeKey.length > 200) {\n  return fail('dedupe_key must be between 1 and 200 characters.');\n}\n\nreturn [{\n  json: {\n    valid: true,\n    user_ids: userIds,\n    group_id: groupId,\n    include_parents: i.include_parents === true,\n    notification_type: type,\n    title,\n    message,\n    related_url: relatedUrl,\n    dedupe_key: dedupeKey,\n  },\n}];\n"
      },
