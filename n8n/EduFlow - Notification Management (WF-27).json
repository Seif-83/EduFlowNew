    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst attempted = $('CODE | Build Rows').first().json.rows.length;\nif (r.statusCode >= 200 && r.statusCode < 300) {\n  const created = Array.isArray(r.body) ? r.body.length : 0;\n  return [{ json: { success: true, code: 'OK', attempted, created, skipped_duplicates: attempted - created } }];\n}\nreturn [{ json: { success: false, code: 'UPSTREAM_ERROR', message: (r.body && r.body.message) || 'Insert failed. Make sure sql/004 was applied (notifications.dedupe_key).' } }];"
