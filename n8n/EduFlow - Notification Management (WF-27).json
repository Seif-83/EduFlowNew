    {
      "parameters": {
        "jsCode": "const plan = $('CODE | Validate & Plan').first().json;\n\nlet students = [];\nlet parents = [];\nlet warnings = [];\n\ntry {\n  const collected = $('CODE | Collect Students').first().json;\n  if (Array.isArray(collected.student_ids)) {\n    students = collected.student_ids;\n  }\n} catch (e) {}\n\ntry {\n  const parentResp = $('DB | Fetch Parents').first().json;\n  if (parentResp && parentResp.statusCode === 200 && Array.isArray(parentResp.body)) {\n    parents = parentResp.body\n      .map(x => x && x.parent_id)\n      .filter(Boolean);\n  } else if (parentResp && parentResp.statusCode && parentResp.statusCode !== 200) {\n    warnings.push(`Parent lookup returned status ${parentResp.statusCode}`);\n  }\n} catch (e) {}\n\nconst merged = [...new Set([\n  ...(plan.user_ids || []),\n  ...students,\n  ...parents\n])];\n\nif (merged.length > 1000) {\n  warnings.push(`Recipient list truncated from ${merged.length} to 1000`);\n}\n\nconst finalUsers = merged.slice(0, 1000);\n\nconst rows = finalUsers.map(u => ({\n  user_id: u,\n  title: plan.title,\n  message: plan.message,\n  notification_type: plan.notification_type,\n  related_url: plan.related_url,\n  is_read: false,\n  dedupe_key: plan.dedupe_key\n}));\n\nreturn [{\n  json: {\n    has_rows: rows.length > 0,\n    rows,\n    warnings\n  }\n}];"
      },
