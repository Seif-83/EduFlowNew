    {
      "parameters": {
        "jsCode": "const plan = $('CODE | Validate & Plan').first().json;\nconst r = $input.first().json;\nconst uuidRe = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\n\nconst rawStudents = (r.statusCode === 200 && Array.isArray(r.body))\n  ? r.body.map(x => x && x.student_id)\n  : [];\n\nconst students = [...new Set(\n  rawStudents\n    .filter(id => typeof id === 'string' && uuidRe.test(id.trim()))\n    .map(id => id.trim())\n)];\n\nreturn [{\n  json: {\n    student_ids: students,\n    need_parents: plan.include_parents === true && students.length > 0\n  }\n}];"
      },
