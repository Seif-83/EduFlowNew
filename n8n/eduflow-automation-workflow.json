    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst d = item.data;\nconst question = d.question || d.message || 'ما هي النصائح للمذاكرة؟';\nconst grade = d.grade || 'المرحلة الإعدادية';\n\nconst prompt = `أنت \"المعلم الذكي\" المعتمد في منصة EduFlow التعليمية (نظام ذكاء اصطناعي مدعوم بـ n8n و Gemini).\nأنت تتحدث بلطف وتشجيع مع طالب في ${grade}.\nسؤال الطالب: \"${question}\"\n\nأجب باختصار وترتيب (في 2-4 أسطر) مقدماً شرحاً علمياً مبسطاً، مع أمثلة من الحياة أو المنهج المصري، واختم بعبارة تشجيعية للطالب. باللغة العربية الفصحى.`;\n\nreturn [{\n  json: {\n    ...item,\n    question: question,\n    tutor_prompt: prompt\n  }\n}];"
      },
      "id": "node-tutor-prep-05",
      "name": "1. Format AI Tutor Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        60
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-flash-lite:generateContent?key={{ $json.gemini_key }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [\n    {\n      \"parts\": [\n        {\n          \"text\": {{ JSON.stringify($json.tutor_prompt) }}\n        }\n      ]\n    }\n  ],\n  \"generationConfig\": {\n    \"temperature\": 0.5,\n    \"maxOutputTokens\": 600\n  }\n}",
        "options": {}
      },
      "id": "node-gemini-tutor-06",
      "name": "AI Agent - Gemini Smart Tutor",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        60
      ]
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst text = response.candidates?.[0]?.content?.parts?.[0]?.text || 'مرحباً بك! أنا معلمك الذكي في EduFlow.';\n\nreturn [{\n  json: {\n    route: 'ai_tutor_chat',\n    reply: text,\n    ai_engine: 'n8n + Gemini 3.5 Flash-Lite',\n    status: 'success'\n  }\n}];"
      },
      "id": "node-tutor-parse-07",
      "name": "Parse AI Tutor Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        60
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst d = item.data;\nconst lesson = d.lesson || 'التركيب الذري';\nconst grade = d.grade || 'الصف الثاني الإعدادي';\nconst difficulty = d.difficulty || 'متوسط متوازن';\nconst qCount = d.questionsCount || 5;\n\nconst prompt = `أنت خبير تربوي ومصمم مناهج تعليمية ذكية في منصة EduFlow لطلاب ${grade}.\nالمطلوب إعداد وحدة تعليمية تفاعلية واختبار ذكي لموضوع: \"${lesson}\"، بمستوى صعوبة: \"${difficulty}\"، وعدد أسئلة اختبار: ${qCount}.\n\nقم بتوليد JSON صالح فقط يحتوي بدقة على البنية التالية بدون أي نصوص قبل أو بعد الـ JSON:\n{\n  \"title\": \"${lesson}\",\n  \"grade\": \"${grade}\",\n  \"difficulty\": \"${difficulty}\",\n  \"summary\": \"شرح تعليمي منظم ومبسط وشامل للدرس في فقرتين أو ثلاث فقرات بأسلوب جذاب ومحفز للطلاب\",\n  \"keyPoints\": [\n    \"النقطة الجوهرية الأولى من المنهج\",\n    \"النقطة الجوهرية الثانية\",\n    \"النقطة الجوهرية الثالثة\",\n    \"النقطة الجوهرية الرابعة\"\n  ],\n  \"flashcards\": [\n    { \"front\": \"سؤال استذكار سريع 1؟\", \"back\": \"إجابة ملخصة ومباشرة 1\" },\n    { \"front\": \"سؤال استذكار سريع 2؟\", \"back\": \"إجابة ملخصة ومباشرة 2\" },\n    { \"front\": \"سؤال استذكار سريع 3؟\", \"back\": \"إجابة ملخصة ومباشرة 3\" },\n    { \"front\": \"سؤال استذكار سريع 4؟\", \"back\": \"إجابة ملخصة ومباشرة 4\" }\n  ],\n  \"questions\": [\n    {\n      \"question\": \"نص السؤال الأول\",\n      \"choices\": [\"الاختيار أ\", \"الاختيار ب\", \"الاختيار ج\", \"الاختيار د\"],\n      \"correctIndex\": 0,\n      \"explanation\": \"شرح سبب صحة الإجابة\"\n    }\n  ]\n}\n\nملاحظات هامة جداً:\n1. توليد عدد أسئلة بالضبط يساوي ${qCount} في مصفوفة questions.\n2. كل سؤال يجب أن يحتوي على 4 اختيارات في مصفوفة choices.\n3. correctIndex يجب أن يكون رقم بين 0 و 3 يحدد الإجابة الصحيحة بدقة.`;\n\nreturn [{\n  json: {\n    ...item,\n    generator_prompt: prompt\n  }\n}];"
      },
