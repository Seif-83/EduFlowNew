    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst d = item.data;\nconst records = Array.isArray(d.records) ? d.records : [];\nconst absent = records.filter(r => r.status === 'absent');\n\nconst alertPayload = {\n  user_id: 'b2c6321d-6bc9-4547-83d7-82b7e0e84d9a',\n  title: `⚠️ تنبيه كشف الحصة (${absent.length} طلاب غائبين)`,\n  message: `تم اعتماد كشف ${d.session_title || 'الحصة'} بواسطة ${d.teacher_name || 'المعلم'}. الغائبون: ${absent.map(s => s.student_name).join('، ') || 'لا يوجد'}.`,\n  notification_type: 'attendance',\n  is_read: false\n};\n\nreturn [{\n  json: {\n    ...item,\n    absent_count: absent.length,\n    supabase_payload: alertPayload\n  }\n}];"
      },
