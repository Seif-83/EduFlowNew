      "id": "node-gemini-gen-09",
      "name": "AI Studio - Lesson & Quiz Generator",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        240
      ]
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst candidate = response.candidates?.[0]?.content?.parts?.[0]?.text;\nlet parsed = {};\ntry {\n  parsed = JSON.parse(candidate);\n} catch (e) {}\n\nreturn [{\n  json: {\n    route: 'ai_generate_lesson',\n    status: 'success',\n    ai_engine: 'n8n + Gemini Structured Generation',\n    lessonData: parsed\n  }\n}];"
      },
      "id": "node-gen-parse-10",
      "name": "Parse Lesson & 3D Cards",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        240
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst d = item.data;\nconst pct = Math.round((d.earnedScore / (d.totalScore || 1)) * 100);\nconst passed = pct >= (d.passingPercentage || 70);\n\nconst notificationPayload = {\n  user_id: 'b2c6321d-6bc9-4547-83d7-82b7e0e84d9a',\n  title: passed ? `🎉 اجتياز اختبار: ${d.student_name}` : `📝 نتيجة اختبار: ${d.student_name}`,\n  message: `أتم الطالب ${d.student_name} حل ${d.exam_title || 'الاختبار'} بنتيجة ${d.earnedScore}/${d.totalScore} (%${pct}).`,\n  notification_type: 'exam',\n  is_read: false\n};\n\nreturn [{\n  json: {\n    ...item,\n    pct,\n    passed,\n    supabase_payload: notificationPayload\n  }\n}];"
      },
