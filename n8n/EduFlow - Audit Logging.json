    {
      "id": "code-exams-1795566068981",
      "name": "CODE – Process Exam",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        696,
        596
      ],
      "parameters": {
        "jsCode": "// EduFlow Exams & Assessment Hub - real Supabase persistence\nconst raw = $input.first().json;\nconst b = (raw.body && typeof raw.body === 'object') ? raw.body : raw;\nconst action = String(b.action || 'exam.create_draft').trim();\nconst BASE = 'https://zhbntxnsdznpdqmjyxpp.supabase.co/rest/v1';\nconst isUuid = (v) => typeof v === 'string' &&\n  /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(v);\n\nconst fail = (message) => [{ json: { valid: false, success: false, error: message } }];\nconst ok = (method, url, body, extra) => [{ json: {\n  valid: true, _method: method, _url: url, _body: JSON.stringify(body), ...(extra || {}) } }];\n\nif (action === 'exam.create_draft' || action === 'exam.create') {\n  if (!isUuid(b.session_id)) return fail('session_id (UUID) is required to create an exam.');\n  const body = {\n    session_id: b.session_id,\n    title: b.title || 'اختبار EduFlow',\n    passing_score: typeof b.passing_score === 'number' ? b.passing_score : 70,\n    duration_minutes: b.duration_minutes || 15,\n    is_published: !!b.is_published,\n  };\n  for (const k of ['subject','grade_level','deadline','creator_role','creation_mode','curriculum_type','material_url']) {\n    if (b[k] !== undefined && b[k] !== null) body[k] = b[k];\n  }\n  return ok('POST', BASE + '/exams', body, { action });\n}\n\nif (action === 'exam.publish') {\n  if (!isUuid(b.exam_id)) return fail('exam_id (UUID) is required to publish an exam.');\n  return ok('PATCH', BASE + '/exams?id=eq.' + b.exam_id, { is_published: true }, { action });\n}\n\nif (action === 'exam.start_attempt') {\n  if (!isUuid(b.exam_id) || !isUuid(b.student_id)) return fail('exam_id and student_id (UUID) are required.');\n  return ok('POST', BASE + '/exam_attempts', {\n    exam_id: b.exam_id, student_id: b.student_id, started_at: new Date().toISOString(),\n  }, { action });\n}\n\nif (action === 'exam.submit_attempt') {\n  if (!isUuid(b.exam_id) || !isUuid(b.student_id)) return fail('exam_id and student_id (UUID) are required.');\n  const score = typeof b.score === 'number' ? b.score : (parseFloat(b.score) || 0);\n  const total = typeof b.total_score === 'number' ? b.total_score : (parseFloat(b.total_score) || 0);\n  const pct = total > 0 ? (score / total) * 100 : 0;\n  const body = {\n    exam_id: b.exam_id,\n    student_id: b.student_id,\n    score,\n    started_at: b.started_at || new Date().toISOString(),\n    submitted_at: b.submitted_at || new Date().toISOString(),\n    passed: b.passed !== undefined ? !!b.passed : (total > 0 ? pct >= 70 : score >= 70),\n  };\n  if (total > 0) body.total_score = total;\n  return ok('POST', BASE + '/exam_attempts', body, { action });\n}\n\nreturn fail('Unsupported action: ' + action);"
      }
    },
