      "parameters": {
        "jsCode": "// EduFlow SW-06 — Audit Logging\n// Handles both Sub-Workflow calls & Webhook POST calls\n\nconst items = $input.all();\n\nfunction isUuid(value) {\n  return typeof value === 'string' &&\n    /^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(value);\n}\n\nreturn items.map((item, index) => {\n  const raw = item.json ?? {};\n  const input = (raw.body && typeof raw.body === 'object') ? { ...raw, ...raw.body } : raw;\n\n  const action = String(input.action ?? '').trim();\n  const entityType = String(input.entity_type ?? '').trim();\n\n  if (!action) {\n    throw new Error(`Audit item ${index + 1}: \"action\" is required.`);\n  }\n  if (!entityType) {\n    throw new Error(`Audit item ${index + 1}: \"entity_type\" is required.`);\n  }\n  if (action.length > 120) {\n    throw new Error(`Audit item ${index + 1}: \"action\" must be 120 characters or fewer.`);\n  }\n  if (entityType.length > 80) {\n    throw new Error(`Audit item ${index + 1}: \"entity_type\" must be 80 characters or fewer.`);\n  }\n\n  const asJsonObject = (value, fieldName) => {\n    if (value === undefined || value === null) return null;\n    if (typeof value !== 'object' || Array.isArray(value)) {\n      throw new Error(`Audit item ${index + 1}: \"${fieldName}\" must be an object or null.`);\n    }\n    return value;\n  };\n\n  const detailsObj = asJsonObject(input.details, 'details') ?? {};\n\n  // Normalize workspace_id, actor_id, entity_id to UUID or null (safe for Postgres UUID columns)\n  let cleanWorkspaceId = null;\n  if (input.workspace_id) {\n    if (isUuid(input.workspace_id)) cleanWorkspaceId = input.workspace_id;\n    else detailsObj.original_workspace_id = String(input.workspace_id);\n  }\n\n  let cleanActorId = null;\n  if (input.actor_id) {\n    if (isUuid(input.actor_id)) cleanActorId = input.actor_id;\n    else detailsObj.original_actor_id = String(input.actor_id);\n  }\n\n  let cleanEntityId = null;\n  if (input.entity_id) {\n    if (isUuid(input.entity_id)) cleanEntityId = input.entity_id;\n    else detailsObj.original_entity_id = String(input.entity_id);\n  }\n\n  return {\n    json: {\n      workspace_id: cleanWorkspaceId,\n      actor_id: cleanActorId,\n      actor_role: input.actor_role ? String(input.actor_role).trim() : null,\n      action,\n      entity_type: entityType,\n      entity_id: cleanEntityId,\n      source: input.source ? String(input.source).trim().slice(0, 120) : 'n8n',\n      details: detailsObj,\n      before_data: asJsonObject(input.before_data, 'before_data'),\n      after_data: asJsonObject(input.after_data, 'after_data')\n    }\n  };\n});"
      },
