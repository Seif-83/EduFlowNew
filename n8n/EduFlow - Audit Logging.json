        696,
        396
      ],
      "parameters": {
        "jsCode": "// EduFlow Notifications Hub - fan out and persist each notification row.\nconst raw = $input.first().json;\nconst b = (raw.body && typeof raw.body === 'object') ? raw.body : raw;\nconst isUuid = (v) => typeof v === 'string' &&\n  /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(v);\n\nconst title = b.title || 'EduFlow Notification';\nconst message = b.message || '';\nconst ntype = b.notification_type || 'general';\nconst related = b.related_url || null;\nconst userIds = Array.isArray(b.user_ids) ? b.user_ids.filter(isUuid) : [];\n\nif (userIds.length === 0) {\n  // Keep one item flowing so the HTTP node always produces output.\n  return [{ json: { _skip: true, reason: 'no valid UUID user_ids' } }];\n}\n\nreturn userIds.map((uid) => ({ json: {\n  _skip: false,\n  _body: JSON.stringify({\n    user_id: uid,\n    title,\n    message,\n    notification_type: ntype,\n    related_url: related,\n    is_read: false,\n  })\n} }));"
      }
    },
